{
  "name": "secure-browser-mcp",
  "version": "0.0.1",
  "private": true,
  "description": "MCP server that brokers Turnkey-stored secrets into a browser it exclusively owns, without exposing secret material to the agent",
  "type": "module",
  "scripts": {
    "dev": "bun run src/index.ts",
    "serve": "bun run src/http.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/index.ts src/http.ts --target=node --outdir=dist",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "test": "bun test",
    "demo:fixture": "bun run test/fixtures/serve.ts",
    "eval": "bun run evals/run.ts",
    "skill:install": "bun run scripts/install-skill.ts",
    "hermes:config": "bun run scripts/hermes-config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.0",
    "@modelcontextprotocol/server": "2.2.0",
    "@turnkey/browser-secrets": "0.0.1-alpha.0",
    "@turnkey/crypto": "^2.12.0",
    "@turnkey/sdk-server": "^8.3.0",
    "puppeteer-core": "^24.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@types/bun": "^1.2.0",
    "@types/node": "^22.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "hono": "4.13.12"
  }
}
